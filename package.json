{
  "name": "dashboard-server-desktop",
  "productName": "LabServer",
  "version": "0.1.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/rendra24/LabServer.git"
  },
  "description": "LabServer — ruang kerja SSH dan Nginx untuk server Anda",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "vendor": "node scripts/vendor.js",
    "prestart": "npm run vendor",
    "start": "electron .",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\" \"test/integration/*.test.js\"",
    "test:ui": "electron scripts/smoke-ui.js",
    "lint": "eslint .",
    "css": "tailwindcss -i src/renderer/input.css -o src/renderer/app.css --minify",
    "build:renderer": "npm run vendor && npm run css",
    "verify:mac": "node scripts/verify-mac.js",
    "dist:mac": "npm run build:renderer && electron-builder --mac --publish never && npm run verify:mac",
    "dist:win": "npm run build:renderer && electron-builder --win --publish never"
  },
  "dependencies": {
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/cli": "4.3.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ace-builds": "1.45.0",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "tailwindcss": "4.3.3",
    "uplot": "1.6.32"
  },
  "author": "LabServer",
  "build": {
    "appId": "com.dashboardserver.desktop",
    "productName": "LabServer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "package.json",
      "!src/renderer/input.css",
      "!**/*.map",
      "!**/*.md",
      "!**/test/**",
      "!**/.github/**",
      "!**/*.node",
      "!**/binding.gyp"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "LabServer ${version}",
      "artifactName": "LabServer-macOS-${arch}.dmg"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
