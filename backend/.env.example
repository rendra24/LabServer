# Salin ke .env lalu sesuaikan. Jangan commit .env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/dashboard_server
# DB terpisah untuk pytest (dikosongkan/dibuat ulang oleh tes migrasi)
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/dashboard_server_test

NGINX_AVAILABLE_DIR=/etc/nginx/sites-available
NGINX_ENABLED_DIR=/etc/nginx/sites-enabled
